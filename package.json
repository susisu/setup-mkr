{
  "name": "@susisu/setup-mkr",
  "version": "4.0.2",
  "private": true,
  "description": "Setup mkr - CLI for Mackerel",
  "keywords": [
    "actions",
    "mackerel",
    "mkr",
    "setup"
  ],
  "license": "MIT",
  "author": "Susisu <susisu2413@yahoo.co.jp>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susisu/setup-mkr.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:dev": "vitest dev --coverage.enabled --coverage.reporter=text",
    "build": "ncc build src/index.ts --source-map --license licenses.txt",
    "clean": "rimraf dist coverage",
    "all": "run-s clean format:check lint:check typecheck test build"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@susisu/oxlint-config": "^0.0.1",
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.1.4",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  }
}
